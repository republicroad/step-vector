# 假 kubeconfig：仅为让 kubernetes_logs source 在集群外完成启动检查。
# 指向不存在的 API server，pod 元数据增强会失败并告警，但 /var/log/pods 文件采集照常工作。
# 真实集群请使用 k8s/daemonset.yaml（in-cluster 自动配置，无需本文件）。
apiVersion: v1
kind: Config
clusters:
  - cluster:
      server: https://127.0.0.1:1
    name: fake
contexts:
  - context:
      cluster: fake
      user: fake
    name: fake
current-context: fake
users:
  - name: fake
    user:
      token: fake-token
